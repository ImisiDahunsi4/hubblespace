{
  "name": "nightly_room_reset",
  "description": "07:00 UTC \u2014 every room with a saved baseline returns to it (was convex/crons.ts 'nightly room reset').",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_room_reset",
      "namespace": "base44",
      "version": "1.0.0"
    },
    "do": [
      {
        "invoke": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nightlyReset"
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "config": {
      "cron_expression": "0 7 * * *",
