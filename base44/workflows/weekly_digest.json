{
  "name": "weekly_digest",
  "description": "Friday 16:00 UTC \u2014 each space emails its week to everyone who wrote to it (was convex/crons.ts 'weekly digest').",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_digest",
      "namespace": "base44",
      "version": "1.0.0"
    },
    "do": [
      {
        "invoke": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyDigest"
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "config": {
      "cron_expression": "0 16 * * 5",
      "timezone": "UTC",
      "trigger_type": "scheduled"
    }
  },
  "change_summary": "Ported from convex/crons.ts"
}